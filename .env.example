# Supabase is optional for the hackathon's session-only golden path. The URL and
# publishable key form the public client pair. Add the secret key only when a
# reviewed server-only operation genuinely needs elevated access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only integrations used by the golden path. Never prefix these with
# NEXT_PUBLIC_ or expose them to browser code.
MODEL_API_KEY=
TICKETMASTER_API_KEY=
CRON_SECRET=

# Optional overrides
META_MODEL=muse-spark-1.3
NEXT_PUBLIC_APP_URL=http://localhost:3000
